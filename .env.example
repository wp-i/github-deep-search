# GitHub Deep Search 0.1.0
#
# You may copy this file to .env, but config/user_keys.env is recommended for
# local credentials. Never commit either populated file.

# Required: read-only access to public GitHub repository metadata and contents.
GITHUB_TOKEN=

# Required: OpenAI-compatible Chat Completions provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Optional provider-specific controls.
LLM_THINKING=
LLM_REASONING_EFFORT=

# Runtime limits.
MAX_GITHUB_REQUESTS=200
MAX_CANDIDATES=80
MAX_EVIDENCE_REPOSITORIES=12
RUN_TIMEOUT_SECONDS=600

# Local Web server.
GITHUB_DEEP_SEARCH_HOST=127.0.0.1
GITHUB_DEEP_SEARCH_PORT=8001
GITHUB_DEEP_SEARCH_RELOAD=1
